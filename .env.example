# =============================================================================
#  SETUP
# =============================================================================
#
#  1. Copy this file:            cp .env.example .env.local
#  2. Fill in the values below.
#  3. Restart the dev server — Next.js only reads .env.local at startup.
#
#  .env.local is gitignored. Never commit it, and never paste a real key
#  into this file.
#
#  For production, add the same variables in:
#    Vercel -> Project -> Settings -> Environment Variables
#    (tick Production, Preview AND Development)
#
#  Nothing here is strictly required to run the site — every feature degrades
#  gracefully if its key is missing. Set them in the order below.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. AI ASSISTANT  (the chat bot, /api/chat)          ** START HERE **
# -----------------------------------------------------------------------------
# Where: https://console.groq.com/keys -> "Create API Key"
# Then:  https://console.groq.com/settings/billing -> set a SPEND LIMIT.
#        /api/chat is a public endpoint and every message costs money.
#
# Starts with "gsk_". Server-only — do NOT rename it to NEXT_PUBLIC_*,
# that would ship your key to every visitor's browser.
#
# If unset: the site works fine, the bot politely says it isn't configured.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL. Which model answers. Change it here when Groq retires one —
# that's a dashboard edit instead of a code change and redeploy.
# Current list: https://console.groq.com/docs/models
# If unset: falls back to llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile


# -----------------------------------------------------------------------------
# 2. SITE URL  (locks the chat API to your own domain)
# -----------------------------------------------------------------------------
# Your live domain, no trailing slash. Blocks other websites from calling
# your chat endpoint and spending your Groq credit.
#
# www., *.vercel.app previews and localhost are allowed automatically —
# you do not need to list them.
#
# Baked in at build time, so changing it needs a redeploy.
# If unset: the origin check is skipped entirely (bot still works).
NEXT_PUBLIC_SITE_URL=https://hakkan.is-a.dev


# -----------------------------------------------------------------------------
# 3. CONTACT FORM  (Resend)
# -----------------------------------------------------------------------------
# Where: https://resend.com/api-keys
# Delivers the "Write to the Hero!" form to hakkanparbej@gmail.com.
# Starts with "re_".
#
# If unset: the form submits but no email arrives.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# 4. VISITOR PINGS  (Discord — optional, nice to have)
# -----------------------------------------------------------------------------
# Where: Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook
# Pings you when someone visits, with their referrer and rough location.
#
# If unset: visits simply aren't reported.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx


# -----------------------------------------------------------------------------
# 5. VISITOR COUNTER  (Firebase — optional)
# -----------------------------------------------------------------------------
# Where: https://console.firebase.google.com
#        Project Settings -> General -> Your apps -> Web app (</>)
#        Copy each value out of the firebaseConfig object it shows you.
#
# These are NEXT_PUBLIC_* on purpose — Firebase web config is meant to be
# public. Your Firestore rules are what actually protect the data.
#
# If unset: the counter just doesn't increment.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id


# =============================================================================
#  A NOTE ON FORMAT
# =============================================================================
#  One KEY=value per line. No spaces around "=". No quotes needed.
#  A line without an "=" is silently ignored — which is exactly how a stray
#  pasted token can sit in .env.local for months doing nothing. Check yours.
# =============================================================================
