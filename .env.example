# Groq (powers the portfolio assistant at /api/chat)
# REQUIRED for the bot to work. Get a key at https://console.groq.com/keys
# — and set a spend limit while you're there, the endpoint is public.
GROQ_API_KEY=your_groq_api_key_here
# Optional. Overrides the default model so a deprecation is a dashboard change,
# not a redeploy. Current ids: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. When set in production, /api/chat rejects requests from other origins.
NEXT_PUBLIC_SITE_URL=https://hakkan.is-a.dev

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Discord Webhook (Visitor Notifications)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Firebase Configuration 
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
